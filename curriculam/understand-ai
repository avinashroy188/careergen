<!-- CareerGen Interactive Controller Script -->
<script id="careergen-interactive-controller">
// Intercept Framer form submissions to mock 200 OK so Framer never shows "Something went wrong"
if (typeof window !== 'undefined' && window.fetch) {
  var _origFetch = window.fetch;
  window.fetch = async function(url, options) {
    if (typeof url === 'string' && url.includes('api.framer.com/forms')) {
      return new Response(JSON.stringify({ status: 'ok' }), {
        status: 200,
        headers: { 'Content-Type': 'application/json' }
      });
    }
    return _origFetch.apply(this, arguments);
  };
}

function careergenOpenModal(type) {
  if (type === 'pdf') {
    var modal = document.getElementById('careergen-pdf-modal');
    var iframe = document.getElementById('careergen-pdf-frame');
    if (modal && iframe) {
      if (!iframe.src || iframe.src === 'about:blank' || iframe.src === window.location.href) {
        iframe.src = iframe.getAttribute('data-src');
      }
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  } else if (type === 'video') {
    var vModal = document.getElementById('careergen-video-modal');
    var video = document.getElementById('careergen-demo-video');
    if (vModal) {
      vModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      if (video) {
        video.play().catch(function(e) {});
      }
    }
  }
}

function careergenCloseModal(type) {
  if (type === 'pdf') {
    var modal = document.getElementById('careergen-pdf-modal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  } else if (type === 'video') {
    var vModal = document.getElementById('careergen-video-modal');
    var video = document.getElementById('careergen-demo-video');
    if (vModal) {
      vModal.style.display = 'none';
      document.body.style.overflow = '';
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
    }
  }
}

// Close on Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    careergenCloseModal('pdf');
    careergenCloseModal('video');
  }
});

// Single Unified Click Delegator
function careergenHandleClick(e) {
  var target = e.target;
  if (!target) return;
  var btn = target.closest('a, button, [data-framer-name="Button"], [data-framer-name*="Phone"], [data-framer-name="Desktop"]') || target;
  var text = (btn.innerText || btn.textContent || '').trim().toLowerCase();

  // 1. Handle "Download Curriculum" -> View PDF in another tab
  var isDownloadCurriculum = (text.includes('download') || text.includes('dowload')) && 
                             (text.includes('curricul') || text.includes('curriccul'));
  if (isDownloadCurriculum) {
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();
    var pdfPath = window.location.origin + '/careergen_curriculam.pdf';
    window.open(pdfPath, '_blank');
    return false;
  }

  // 2. Handle "View Curriculum" -> In-page pop-up modal ONLY, strictly NO new tabs
  if (text.includes('view curriculum') && !isDownloadCurriculum) {
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();
    careergenOpenModal('pdf');
    return false;
  }

  // 3. Handle "Watch a Demo"
  if (text.includes('watch a demo') || text.includes('watch demo')) {
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();
    careergenOpenModal('video');
    return false;
  }

  // 4. Handle Curriculum Page Cards Direct Routing
  if (window.location.pathname.includes('curriculam')) {
    var card = target.closest('a[href*="curriculam/"], [data-framer-name="Flip"], [data-framer-name="Desktop"], [data-framer-name="Phone"]');
    if (card) {
      var cardText = (card.innerText || card.textContent || '').toLowerCase();
      var dest = null;
      if (cardText.includes('understand ai')) {
        dest = 'understand-ai';
      } else if (cardText.includes('advanced ai')) {
        dest = 'advanced-ai-skills';
      } else if (cardText.includes('prompting') || cardText.includes('ai tools')) {
        dest = 'build-launch-website';
      } else if (cardText.includes('build') && (cardText.includes('deploy') || cardText.includes('website'))) {
        dest = 'deploy-share-website';
      }

      if (dest) {
        var targetUrl = window.location.origin + '/curriculam/' + dest;
        if (window.location.href !== targetUrl) {
          e.preventDefault();
          e.stopPropagation();
          window.location.href = targetUrl;
          return false;
        }
      }
    }
  }

  // 5. Handle Contact Form "Send Request" Button Click
  var isContactBtn = text.includes('send request') || 
                     (btn.getAttribute && (btn.getAttribute('data-framer-name') === 'Contact Button' || btn.getAttribute('name') === 'Contact Button')) ||
                     btn.name === 'Contact Button';
  if (isContactBtn) {
    var form = btn.closest('form') || document.querySelector('form');
    if (form) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      careergenSubmitWhatsAppForm(form);
      return false;
    }
  }
}

window.addEventListener('click', careergenHandleClick, true);
document.addEventListener('click', careergenHandleClick, true);

// Form submit event interceptor
function careergenHandleSubmit(e) {
  var form = e.target.closest('form');
  if (!form) return;
  e.preventDefault();
  e.stopPropagation();
  e.stopImmediatePropagation();
  careergenSubmitWhatsAppForm(form);
  return false;
}

window.addEventListener('submit', careergenHandleSubmit, true);
document.addEventListener('submit', careergenHandleSubmit, true);

// Debouncing / submission lock to guarantee EXACTLY ONE TAB opens
var careergenIsSubmitting = false;

// WhatsApp API Form Submission Handler
function careergenSubmitWhatsAppForm(form) {
  if (careergenIsSubmitting) return;

  // Clear any existing input error highlights
  form.querySelectorAll('.careergen-input-error').forEach(function(el) {
    el.classList.remove('careergen-input-error');
  });

  // Extract inputs
  var parentInput = form.querySelector('input[placeholder*="Parent"]') || form.querySelector('input[name="Full Name"]');
  var parentName = parentInput ? parentInput.value.trim() : '';

  var childInput = form.querySelector('input[placeholder*="Child"]');
  var childName = childInput ? childInput.value.trim() : '';

  var phoneInput = form.querySelector('input[name="Phone"]') || form.querySelector('input[type="tel"]') || form.querySelector('input[placeholder*="91"]');
  var phone = phoneInput ? phoneInput.value.trim() : '';

  var emailInput = form.querySelector('input[name="Email"]') || form.querySelector('input[name="Email Address"]') || form.querySelector('input[type="email"]');
  var email = emailInput ? emailInput.value.trim() : '';

  // Extract selected class
  var classRadio = form.querySelector('input[type="radio"]:checked');
  var studentClass = classRadio ? (classRadio.closest('label')?.innerText?.trim() || classRadio.value) : '';

  // Extract selected interests (multiple checkboxes)
  var interestCbs = form.querySelectorAll('input[type="checkbox"]:checked');
  var interests = [];
  interestCbs.forEach(function(cb) {
    var t = cb.closest('label')?.innerText?.trim() || cb.value;
    if (t) interests.push(t);
  });

  // Extract message
  var msgTextarea = form.querySelector('textarea[name="Message"]') || form.querySelector('textarea');
  var message = msgTextarea ? msgTextarea.value.trim() : '';

  // Status Box reference
  var statusBox = document.getElementById('careergen-form-status-box');
  if (!statusBox) {
    statusBox = document.createElement('div');
    statusBox.id = 'careergen-form-status-box';
    form.parentNode.insertBefore(statusBox, form.nextSibling);
  }

  // Get submit button & label
  var submitBtn = form.querySelector('button[name="Contact Button"]') || form.querySelector('button[type="submit"]') || form.querySelector('button');
  var submitBtnTextEl = submitBtn ? (submitBtn.querySelector('.framer-1ocdhwz p') || submitBtn.querySelector('p') || submitBtn) : null;
  var origBtnText = submitBtnTextEl ? submitBtnTextEl.innerText : 'Send request';

  // Validation: Parent Name
  if (!parentName) {
    if (parentInput) {
      parentInput.classList.add('careergen-input-error');
      parentInput.focus();
    }
    statusBox.className = 'careergen-form-status error';
    statusBox.innerHTML = '<span>⚠️ Please enter your Parent or Guardian name.</span>';
    statusBox.style.display = 'flex';
    if (submitBtnTextEl) submitBtnTextEl.innerText = '⚠️ Please enter your name';
    setTimeout(function() { if (submitBtnTextEl) submitBtnTextEl.innerText = origBtnText; }, 3000);
    return;
  }

  // Validation: Phone
  if (!phone) {
    if (phoneInput) {
      phoneInput.classList.add('careergen-input-error');
      phoneInput.focus();
    }
    statusBox.className = 'careergen-form-status error';
    statusBox.innerHTML = '<span>⚠️ Please enter your contact Phone number.</span>';
    statusBox.style.display = 'flex';
    if (submitBtnTextEl) submitBtnTextEl.innerText = '⚠️ Please enter phone number';
    setTimeout(function() { if (submitBtnTextEl) submitBtnTextEl.innerText = origBtnText; }, 3000);
    return;
  }

  // Lock submission for 3 seconds to guarantee only ONE tab opens
  careergenIsSubmitting = true;
  setTimeout(function() { careergenIsSubmitting = false; }, 3000);

  // Update button state immediately to "Request was sent"
  if (submitBtn) {
    submitBtn.style.setProperty('background-color', '#25D366', 'important');
    submitBtn.style.setProperty('border-color', '#128C7E', 'important');
    submitBtn.style.setProperty('box-shadow', '0px 4px 0px 0px #128C7E', 'important');
    submitBtn.style.setProperty('opacity', '1', 'important');
  }
  if (submitBtnTextEl) {
    submitBtnTextEl.innerText = '✓ Request was sent';
    submitBtnTextEl.style.setProperty('color', '#ffffff', 'important');
  }

  // Keep button text updated in case of React/Framer rerender
  var keepCount = 0;
  var keepInterval = setInterval(function() {
    keepCount++;
    if (submitBtnTextEl) {
      submitBtnTextEl.innerText = '✓ Request was sent';
      submitBtnTextEl.style.color = '#ffffff';
    }
    if (keepCount > 20) clearInterval(keepInterval);
  }, 100);

  // Construct structured WhatsApp message for target number: 8688282524
  var waMessage = "👋 *New CareerGen Course Inquiry*\n\n" +
    "👤 *Parent / Guardian:* " + parentName + "\n" +
    (childName ? "🧒 *Child Name:* " + childName + "\n" : "") +
    "📞 *Phone:* " + phone + "\n" +
    (email ? "✉️ *Email:* " + email + "\n" : "") +
    (studentClass ? "🏫 *Student Class:* " + studentClass + "\n" : "") +
    (interests.length > 0 ? "🎯 *Interests:* " + interests.join(', ') + "\n" : "") +
    (message ? "💬 *Note:* " + message + "\n" : "") +
    "\n_Sent via CareerGen Website_";

  var waUrl = "https://wa.me/918688282524?text=" + encodeURIComponent(waMessage);

  // Update on-page status banner
  statusBox.className = 'careergen-form-status success';
  statusBox.innerHTML = '<span>✓ Request was sent! Triggered to the WhatsApp API. Opening WhatsApp (8688282524)...</span>';
  statusBox.style.display = 'flex';

  // Open WhatsApp in exactly ONE new tab
  var waWindow = window.open(waUrl, '_blank');
  if (!waWindow || waWindow.closed || typeof waWindow.closed === 'undefined') {
    statusBox.innerHTML += ' <a href="' + waUrl + '" target="_blank" style="color:#128c7e;text-decoration:underline;margin-left:8px;font-weight:700">Click here to open WhatsApp</a>';
  }
}
</script>
</body>
