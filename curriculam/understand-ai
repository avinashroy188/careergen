          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF</span>
        </a>
        <button type="button" class="careergen-modal-close-btn" onclick="careergenCloseModal('pdf')" aria-label="Close Curriculum Viewer">✕</button>
      </div>
    </div>
    <div class="careergen-modal-body careergen-pdf-body">
      <iframe id="careergen-pdf-frame" data-src="../careergen_curriculam.pdf#toolbar=1" src="" title="CareerGen AI Literacy Camp Curriculum"></iframe>
    </div>
  </div>
</div>

